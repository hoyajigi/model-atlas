---
import Base from '../layouts/Base.astro'
import { allOfferings, fmtContext, href } from '../lib/data'

const rows = allOfferings()
  .filter(({ offering }) => offering.pricing?.input_per_mtok !== undefined && offering.status === 'active')
  .sort((a, b) => (a.offering.pricing?.input_per_mtok ?? 0) - (b.offering.pricing?.input_per_mtok ?? 0))
const providers = [...new Set(rows.map((r) => r.provider.id))].sort()
---

<Base title="API Pricing">
  <h1>LLM API pricing</h1>
  <p class="lede">
    {rows.length} active offerings across {providers.length} providers, in USD per million tokens.
    Synced daily from <a href="https://models.dev">models.dev</a> and cross-checked against LiteLLM.
  </p>

  <div class="filters">
    <input id="q" type="search" placeholder="Search model…" />
    <span id="count" class="muted" style="align-self: center;">{rows.length} shown</span>
    <select id="provider">
      <option value="">All providers</option>
      {providers.map((p) => <option value={p}>{p}</option>)}
    </select>
  </div>

  <div class="table-wrap">
    <table id="pricing">
      <thead>
        <tr>
          <th data-sort="str" data-key="pname">Provider</th><th data-sort="str" data-key="mname">Model</th>
          <th data-sort="num" data-key="context">Context</th>
          <th data-sort="num" data-key="pin">Input $/M</th><th data-sort="num" data-key="pout">Output $/M</th>
          <th data-sort="num" data-key="pcache">Cache read $/M</th><th data-sort="str" data-key="asof">As of</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ provider, offering }) => (
          <tr
            data-name={offering.name.toLowerCase()}
            data-provider={provider.id}
            data-pname={provider.name}
            data-mname={offering.name}
            data-context={offering.context ?? ''}
            data-pin={offering.pricing?.input_per_mtok ?? ''}
            data-pout={offering.pricing?.output_per_mtok ?? ''}
            data-pcache={offering.pricing?.cache_read_per_mtok ?? ''}
            data-asof={offering.source.as_of}
          >
            <td>{provider.name}</td>
            <td>{offering.model_ref ? <a href={href(`/models/${offering.model_ref}`)}>{offering.name}</a> : offering.name}</td>
            <td>{fmtContext(offering.context)}</td>
            <td>${offering.pricing?.input_per_mtok}</td>
            <td>${offering.pricing?.output_per_mtok ?? '—'}</td>
            <td>{offering.pricing?.cache_read_per_mtok !== undefined ? `$${offering.pricing.cache_read_per_mtok}` : '—'}</td>
            <td class="muted">{offering.source.as_of}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>

<script>
  import { initSort } from '../lib/table-client'

  initSort(document.getElementById('pricing') as HTMLTableElement)
  const q = document.getElementById('q') as HTMLInputElement
  const provider = document.getElementById('provider') as HTMLSelectElement
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('#pricing tbody tr')]
  const count = document.getElementById('count') as HTMLElement

  const apply = () => {
    const needle = q.value.trim().toLowerCase()
    let shown = 0
    for (const row of rows) {
      const okText = !needle || (row.dataset.name ?? '').includes(needle)
      const okProvider = !provider.value || row.dataset.provider === provider.value
      const visible = okText && okProvider
      row.style.display = visible ? '' : 'none'
      if (visible) shown += 1
    }
    count.textContent = `${shown} shown`
  }
  for (const el of [q, provider]) {
    el.addEventListener('input', apply)
    el.addEventListener('change', apply)
  }
  apply()
</script>
