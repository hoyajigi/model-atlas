---
import Base from '../../../layouts/Base.astro'
import { allOfferings, atlas, fmtContext, fmtParams } from '../../../lib/data'

export function getStaticPaths() {
  return Object.keys(atlas.models).map((ref) => {
    const [org, id] = ref.split('/')
    return { params: { org, id } }
  })
}

const { org, id } = Astro.params
const ref = `${org}/${id}`
const model = atlas.models[ref]
if (!model) throw new Error(`Unknown model ${ref}`)
const offerings = allOfferings().filter(({ offering }) => offering.model_ref === ref)
const benchmarks = Object.entries(model.benchmarks ?? {})
const hardware = (atlas.hardware ?? [])
  .filter((h) => h.model_ref === ref)
  .sort((a, b) => (b.tok_per_s ?? 0) - (a.tok_per_s ?? 0))
const hwOptions = {
  hardware: [...new Set(hardware.map((h) => h.hardware))].sort(),
  engine: [...new Set(hardware.map((h) => h.engine))].sort(),
  quant: [...new Set(hardware.map((h) => h.quant))].sort()
}
---

<Base title={model.name}>
  <h1>{model.name}</h1>
  <p class="lede">
    {model.org} · <span class="tag">{model.modality}</span>
    {model.open_weights && <span class="tag open">open weights</span>}
  </p>

  <div class="table-wrap">
    <table>
      <tbody>
        <tr><th>Parameters</th><td>{fmtParams(model.params)}{model.active_params ? ` (${fmtParams(model.active_params)} active)` : ''}</td></tr>
        <tr><th>Context</th><td>{fmtContext(model.context)}</td></tr>
        <tr><th>License</th><td>{model.license ?? 'unknown'}</td></tr>
        <tr><th>Released</th><td>{model.release_date ?? '—'}</td></tr>
        {model.hf_id && (
          <tr><th>Hugging Face</th><td><a href={`https://huggingface.co/${model.hf_id}`}>{model.hf_id}</a></td></tr>
        )}
        <tr><th>Source</th><td><a href={model.source.url}>{model.source.url}</a> <span class="muted">as of {model.source.as_of}</span></td></tr>
      </tbody>
    </table>
  </div>

  {benchmarks.length > 0 && (
    <>
      <h2>Benchmarks</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Suite</th><th>Score</th><th>As of</th></tr></thead>
          <tbody>
            {benchmarks.map(([suite, b]) => (
              <tr>
                <td><a href={atlas.benchmarks[suite]?.url}>{atlas.benchmarks[suite]?.name ?? suite}</a></td>
                <td>{b.score}</td>
                <td class="muted">{b.as_of}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {hardware.length > 0 && (
    <>
      <h2>Measured on real hardware</h2>
      <div class="filters">
        <span id="hw-count" class="muted" style="align-self: center;">{hardware.length} shown</span>
        <select id="hw-hardware">
          <option value="">All hardware</option>
          {hwOptions.hardware.map((v) => <option value={v}>{v}</option>)}
        </select>
        <select id="hw-engine">
          <option value="">All engines</option>
          {hwOptions.engine.map((v) => <option value={v}>{v}</option>)}
        </select>
        <select id="hw-quant">
          <option value="">All precisions</option>
          {hwOptions.quant.map((v) => <option value={v}>{v}</option>)}
        </select>
      </div>
      <div class="table-wrap">
        <table id="hw">
          <thead>
            <tr>
              <th data-sort="str" data-key="hw">Hardware</th>
              <th data-sort="str" data-key="quant">Precision</th>
              <th data-sort="str" data-key="engine">Engine</th>
              <th data-sort="num" data-key="conc">Workload</th>
              <th data-sort="num" data-key="speed">Speed</th>
              <th data-sort="num" data-key="ttft">TTFT</th>
              <th data-sort="num" data-key="vram">VRAM</th>
              <th data-sort="str" data-key="date">Measured</th>
            </tr>
          </thead>
          <tbody>
            {hardware.map((h) => (
              <tr
                data-hw={h.hardware}
                data-quant={h.quant}
                data-engine={h.engine}
                data-conc={h.concurrency}
                data-speed={h.tok_per_s ?? (h.sec_per_image ? 1 / h.sec_per_image : '')}
                data-ttft={h.ttft_ms ?? ''}
                data-vram={h.vram_gb ?? ''}
                data-date={h.measured_on ?? ''}
              >
                <td>{h.gpus > 1 ? `${h.gpus}× ` : ''}{h.hardware}</td>
                <td>{h.quant}</td>
                <td>{h.engine}{h.engine_version ? ` ${h.engine_version}` : ''}</td>
                <td>
                  {h.seq_in ? `${h.seq_in}/${h.seq_out} tok, c=${h.concurrency}` : h.resolution ? `${h.resolution}, ${h.steps} steps` : '—'}
                </td>
                <td>
                  {h.tok_per_s ? `${h.tok_per_s} tok/s` : h.sec_per_image ? `${h.sec_per_image}s / image` : '—'}
                </td>
                <td>{h.ttft_ms ? `${h.ttft_ms} ms` : '—'}</td>
                <td>{h.vram_gb ? `${h.vram_gb} GB` : '—'}</td>
                <td class="muted">{h.measured_on ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <script>
    import { initSort } from '../../../lib/table-client'

    const table = document.getElementById('hw') as HTMLTableElement | null
    if (table) {
      initSort(table)
      const selects = ['hw-hardware', 'hw-engine', 'hw-quant'].map((id) => document.getElementById(id) as HTMLSelectElement)
      const keys = ['hw', 'engine', 'quant']
      const count = document.getElementById('hw-count') as HTMLElement
      const rows = [...table.tBodies[0]!.rows]
      const apply = () => {
        let shown = 0
        for (const row of rows) {
          const visible = selects.every((sel, i) => !sel.value || row.dataset[keys[i]!] === sel.value)
          row.style.display = visible ? '' : 'none'
          if (visible) shown += 1
        }
        count.textContent = `${shown} shown`
      }
      for (const sel of selects) sel.addEventListener('change', apply)
    }
  </script>

  <h2>Hosted API offerings</h2>
  {offerings.length === 0 ? (
    <p class="muted">No linked API offerings yet — run it yourself from the weights.</p>
  ) : (
    <div class="table-wrap">
      <table>
        <thead><tr><th>Provider</th><th>API model id</th><th>Pricing</th><th>Context</th></tr></thead>
        <tbody>
          {offerings.map(({ provider, offering }) => {
            const p = offering.pricing
            const price = p?.image
              ? `$${p.image.usd_per_image_1024 ?? p.image.usd} / image`
              : p?.input_per_mtok !== undefined
                ? `$${p.input_per_mtok} in / $${p.output_per_mtok} out per Mtok`
                : '—'
            return (
              <tr>
                <td>{provider.name}</td>
                <td><code>{offering.model_id}</code></td>
                <td>{price}</td>
                <td>{fmtContext(offering.context)}</td>
              </tr>
            )
          })}
        </tbody>
      </table>
    </div>
  )}
</Base>
