---
import Base from '../layouts/Base.astro'
import { allOfferings, atlas, href } from '../lib/data'

const rows = allOfferings()
  .filter(({ offering }) => offering.pricing?.image !== undefined)
  .sort(
    (a, b) =>
      (a.offering.pricing?.image?.usd_per_image_1024 ?? Infinity) -
      (b.offering.pricing?.image?.usd_per_image_1024 ?? Infinity)
  )
const unitLabel: Record<string, string> = {
  per_image: 'per image',
  per_megapixel: 'per megapixel',
  per_gpu_second: 'per GPU-second'
}
const eloOf = (ref?: string): number | undefined =>
  ref ? atlas.models[ref]?.benchmarks?.['lmarena-t2i']?.score : undefined
---

<Base title="Text-to-Image">
  <h1>Text-to-image API pricing</h1>
  <p class="lede">
    {rows.length} image-generation offerings, normalized to the cost of one 1024×1024 image so
    per-image, per-megapixel and token-billed models are comparable. Open-weights models link to their spec page.
    No other open database covers this — prices verified against official pricing pages.
  </p>

  <div class="table-wrap">
    <table id="t2i">
      <thead>
        <tr>
          <th data-sort="str" data-key="pname">Provider</th><th data-sort="str" data-key="mname">Model</th>
          <th data-sort="str" data-key="unit">Billing unit</th><th data-sort="num" data-key="price">Listed price</th>
          <th data-sort="num" data-key="norm">≈ $/image (1024²)</th><th data-sort="num" data-key="elo">Arena Elo</th>
          <th data-sort="str" data-key="open">Open weights</th><th data-sort="str" data-key="asof">As of</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ provider, offering }) => {
          const img = offering.pricing!.image!
          const elo = eloOf(offering.model_ref)
          return (
            <tr
              data-pname={provider.name}
              data-mname={offering.name}
              data-unit={img.unit}
              data-price={img.usd}
              data-norm={img.usd_per_image_1024 ?? ''}
              data-elo={elo ?? ''}
              data-open={offering.model_ref ? 'open' : 'api'}
              data-asof={offering.source.as_of}
            >
              <td>{provider.name}</td>
              <td>{offering.model_ref ? <a href={href(`/models/${offering.model_ref}`)}>{offering.name}</a> : offering.name}</td>
              <td>{unitLabel[img.unit] ?? img.unit}</td>
              <td>${img.usd}</td>
              <td><strong>{img.usd_per_image_1024 !== undefined ? `$${img.usd_per_image_1024}` : '—'}</strong></td>
              <td>{elo ?? '—'}</td>
              <td>{offering.model_ref ? <span class="tag open">open</span> : <span class="tag">API only</span>}</td>
              <td class="muted">{offering.source.as_of}</td>
            </tr>
          )
        })}
      </tbody>
    </table>
  </div>
</Base>

<script>
  import { initSort } from '../lib/table-client'

  initSort(document.getElementById('t2i') as HTMLTableElement)
</script>
