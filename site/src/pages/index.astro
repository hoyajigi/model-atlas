---
import Base from '../layouts/Base.astro'
import { atlas, fmtContext, fmtParams, href } from '../lib/data'

const hwByModel = new Map<string, { terms: string; count: number }>()
for (const h of atlas.hardware ?? []) {
  const seen = hwByModel.get(h.model_ref) ?? { terms: '', count: 0 }
  hwByModel.set(h.model_ref, { terms: `${seen.terms} ${h.hardware} ${h.engine} ${h.quant}`, count: seen.count + 1 })
}
const models = Object.entries(atlas.models)
  .map(([ref, m]) => ({ ref, ...m, hw: hwByModel.get(ref) }))
  .sort((a, b) => (b.params ?? 0) - (a.params ??  0))
const orgs = [...new Set(models.map((m) => m.org))].sort()
const modalities = [...new Set(models.map((m) => m.modality))].sort()
const elo = (m: (typeof models)[number]): number | undefined =>
  m.benchmarks?.['lmarena-text']?.score ?? m.benchmarks?.['lmarena-t2i']?.score
---

<Base title="Models">
  <h1>Open-weights models</h1>
  <p class="lede">
    {models.length} curated models — LLMs and text-to-image, with exact parameter counts from safetensors metadata,
    licenses, and arena Elo. API pricing lives under <a href={href("/pricing")}>API Pricing</a> and <a href={href("/t2i")}>Text-to-Image</a>.
  </p>

  <div class="filters">
    <input id="q" type="search" placeholder="Search name / org / license / hardware (e.g. h100)…" />
    <span id="count" class="muted" style="align-self: center;">{models.length} shown</span>
    <select id="modality">
      <option value="">All modalities</option>
      {modalities.map((m) => <option value={m}>{m}</option>)}
    </select>
    <select id="org">
      <option value="">All orgs</option>
      {orgs.map((o) => <option value={o}>{o}</option>)}
    </select>
  </div>

  <div class="table-wrap">
    <table id="models">
      <thead>
        <tr>
          <th data-sort="str" data-key="mname">Model</th><th data-sort="str" data-key="org">Org</th><th>Modality</th>
          <th data-sort="num" data-key="params">Params</th><th data-sort="num" data-key="active">Active</th>
          <th data-sort="num" data-key="context">Context</th><th data-sort="str" data-key="license">License</th>
          <th data-sort="num" data-key="elo">Arena Elo</th><th data-sort="num" data-key="hw">Measured</th>
          <th data-sort="str" data-key="released">Released</th>
        </tr>
      </thead>
      <tbody>
        {models.map((m) => (
          <tr
            data-name={`${m.name} ${m.org} ${m.license ?? ''}${m.hw?.terms ?? ''}`.toLowerCase()}
            data-modality={m.modality}
            data-org={m.org}
            data-mname={m.name}
            data-params={m.params ?? ''}
            data-active={m.active_params ?? ''}
            data-context={m.context ?? ''}
            data-license={m.license ?? ''}
            data-elo={elo(m) ?? ''}
            data-hw={m.hw?.count ?? 0}
            data-released={m.release_date ?? ''}
          >
            <td><a href={href(`/models/${m.ref}`)}>{m.name}</a></td>
            <td>{m.org}</td>
            <td><span class="tag">{m.modality}</span></td>
            <td>{fmtParams(m.params)}</td>
            <td>{fmtParams(m.active_params)}</td>
            <td>{fmtContext(m.context)}</td>
            <td>{m.license ?? '—'}</td>
            <td>{elo(m) ?? '—'}</td>
            <td>{m.hw ? <a href={href(`/models/${m.ref}`)}>{m.hw.count} configs</a> : '—'}</td>
            <td>{m.release_date ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>

<script>
  import { initSort } from '../lib/table-client'

  initSort(document.getElementById('models') as HTMLTableElement)
  const q = document.getElementById('q') as HTMLInputElement
  const modality = document.getElementById('modality') as HTMLSelectElement
  const org = document.getElementById('org') as HTMLSelectElement
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('#models tbody tr')]

  const count = document.getElementById('count') as HTMLElement

  const apply = () => {
    const needle = q.value.trim().toLowerCase()
    let shown = 0
    for (const row of rows) {
      const okText = !needle || (row.dataset.name ?? '').includes(needle)
      const okModality = !modality.value || row.dataset.modality === modality.value
      const okOrg = !org.value || row.dataset.org === org.value
      const visible = okText && okModality && okOrg
      row.style.display = visible ? '' : 'none'
      if (visible) shown += 1
    }
    count.textContent = `${shown} shown`
  }
  for (const el of [q, modality, org]) {
    el.addEventListener('input', apply)
    el.addEventListener('change', apply)
  }
  apply()
</script>
