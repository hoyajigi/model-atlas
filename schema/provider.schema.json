{
  "$ref": "#/definitions/provider",
  "definitions": {
    "provider": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "api_base": {
          "type": "string",
          "format": "uri"
        },
        "api_style": {
          "type": "string"
        },
        "docs_url": {
          "type": "string",
          "format": "uri"
        },
        "pricing_url": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "as_of": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "url",
            "as_of"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "source"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}