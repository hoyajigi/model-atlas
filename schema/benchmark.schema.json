{
  "$ref": "#/definitions/benchmark",
  "definitions": {
    "benchmark": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "category": {
          "type": "string"
        },
        "higher_is_better": {
          "type": "boolean",
          "default": true
        },
        "data_license": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "as_of": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "url",
            "as_of"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "url",
        "category",
        "source"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}